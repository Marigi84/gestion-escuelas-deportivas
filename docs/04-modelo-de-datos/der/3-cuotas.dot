graph G {
  graph [overlap=false, splines=true, sep="+12", fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#424242"];
  MES [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Mes", fontsize=12];
  MES_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Año y mes</u></i>>, fontsize=10, margin=0.02, height=0.3];
  MES -- MES_a0 [len=0.9];
  MES_a1 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  MES -- MES_a1 [len=0.9];
  MES_a2 [shape=ellipse, style="solid", peripheries=1, label="Monto", fontsize=10, margin=0.02, height=0.3];
  MES -- MES_a2 [len=0.9];
  MES_a3 [shape=ellipse, style="solid", peripheries=1, label="Fecha de vencimiento", fontsize=10, margin=0.02, height=0.3];
  MES -- MES_a3 [len=0.9];
  MES_a4 [shape=ellipse, style="solid", peripheries=2, label="Escalones de recargo", fontsize=10, margin=0.02, height=0.3];
  MES -- MES_a4 [len=0.9];
  CUO [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Cuota", fontsize=12];
  CUO_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha de generación</u></i>>, fontsize=10, margin=0.02, height=0.3];
  CUO -- CUO_a0 [len=0.9];
  CUO_a1 [shape=ellipse, style="solid", peripheries=1, label="Monto", fontsize=10, margin=0.02, height=0.3];
  CUO -- CUO_a1 [len=0.9];
  CUO_a2 [shape=ellipse, style="solid", peripheries=1, label="Descuento", fontsize=10, margin=0.02, height=0.3];
  CUO -- CUO_a2 [len=0.9];
  CUO_a3 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  CUO -- CUO_a3 [len=0.9];
  CUO_a4 [shape=ellipse, style="dashed", peripheries=1, label="Saldo", fontsize=10, margin=0.02, height=0.3];
  CUO -- CUO_a4 [len=0.9];
  REC [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Recargo", fontsize=12];
  REC_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Escalón</u></i>>, fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a0 [len=0.9];
  REC_a1 [shape=ellipse, style="solid", peripheries=1, label="Porcentaje", fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a1 [len=0.9];
  REC_a2 [shape=ellipse, style="solid", peripheries=1, label="Importe", fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a2 [len=0.9];
  REC_a3 [shape=ellipse, style="solid", peripheries=1, label="Fecha de aplicación", fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a3 [len=0.9];
  REC_a4 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a4 [len=0.9];
  REC_a5 [shape=ellipse, style="dashed", peripheries=1, label="Saldo", fontsize=10, margin=0.02, height=0.3];
  REC -- REC_a5 [len=0.9];
  AJU [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Ajuste", fontsize=12];
  AJU_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha y hora</u></i>>, fontsize=10, margin=0.02, height=0.3];
  AJU -- AJU_a0 [len=0.9];
  AJU_a1 [shape=ellipse, style="solid", peripheries=1, label="Importe anterior", fontsize=10, margin=0.02, height=0.3];
  AJU -- AJU_a1 [len=0.9];
  AJU_a2 [shape=ellipse, style="solid", peripheries=1, label="Importe nuevo", fontsize=10, margin=0.02, height=0.3];
  AJU -- AJU_a2 [len=0.9];
  AJU_a3 [shape=ellipse, style="solid", peripheries=1, label="Motivo", fontsize=10, margin=0.02, height=0.3];
  AJU -- AJU_a3 [len=0.9];
  ESC [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Escuela", fontsize=12, fontcolor="#616161"];
  ALU [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Alumno", fontsize=12, fontcolor="#616161"];
  r_abre [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="abre", fontsize=10, margin=0.02];
  r_abre -- ESC [label="1", len=1.6];
  r_abre -- MES [label="N", color="#424242:white:#424242", len=1.6];
  r_genera [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="genera", fontsize=10, margin=0.02];
  r_genera -- MES [label="1", len=1.6];
  r_genera -- CUO [label="N", color="#424242:white:#424242", len=1.6];
  r_debe [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="debe", fontsize=10, margin=0.02];
  r_debe -- ALU [label="1", len=1.6];
  r_debe -- CUO [label="N", color="#424242:white:#424242", len=1.6];
  r_mora [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="por mora", fontsize=10, margin=0.02];
  r_mora -- CUO [label="1", len=1.6];
  r_mora -- REC [label="N", color="#424242:white:#424242", len=1.6];
  r_corrige [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="corrige", fontsize=10, margin=0.02];
  r_corrige -- CUO [label="1", len=1.6];
  r_corrige -- AJU [label="N", color="#424242:white:#424242", len=1.6];
}
