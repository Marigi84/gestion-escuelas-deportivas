  r_fija -- MON [label="N", color="#424242:white:#424242", len=1.6];
  r_admin [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="administra", fontsize=10, margin=0.02];
  r_admin -- USU [label="N", len=1.6];
  r_admin -- ESC [label="M", color="#424242:white:#424242", len=1.6];
  r_admin_a0 [shape=ellipse, label="Estado", fontsize=10, margin=0.02, height=0.3];
  r_admin -- r_admin_a0 [len=0.9];
  r_admin_a1 [shape=ellipse, label="Fecha de alta", fontsize=10, margin=0.02, height=0.3];
  r_admin -- r_admin_a1 [len=0.9];
  r_accede [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="accede como", fontsize=10, margin=0.02];
  r_accede -- USU [label="1", len=1.6];
  r_accede -- TUT [label="1", color="#424242:white:#424242", len=1.6];
}
