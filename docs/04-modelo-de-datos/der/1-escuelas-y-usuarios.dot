  DIS -- DIS_a0 [len=0.9];
  FDP [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Forma de pago", fontsize=12];
  FDP_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Nombre</u>>, fontsize=10, margin=0.02, height=0.3];
  FDP -- FDP_a0 [len=0.9];
  MON [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Monto de cuota", fontsize=12];
  MON_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha desde</u></i>>, fontsize=10, margin=0.02, height=0.3];
