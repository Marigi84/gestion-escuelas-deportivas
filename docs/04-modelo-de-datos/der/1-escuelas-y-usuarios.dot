  TUT -- TUT_a0 [len=0.9];
  TUT_a1 [shape=ellipse, style="solid", peripheries=1, label="Nombre", fontsize=10, margin=0.02, height=0.3];
  TUT -- TUT_a1 [len=0.9];
  TUT_a2 [shape=ellipse, style="solid", peripheries=1, label="Apellido", fontsize=10, margin=0.02, height=0.3];
  TUT -- TUT_a2 [len=0.9];
  TUT_a3 [shape=ellipse, style="solid", peripheries=1, label="Teléfono", fontsize=10, margin=0.02, height=0.3];
