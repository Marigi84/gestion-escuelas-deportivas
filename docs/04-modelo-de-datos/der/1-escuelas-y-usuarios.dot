  r_tiene -- CFG [label="1", color="#424242:white:#424242", len=1.6];
  r_dicta [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="dicta", fontsize=10, margin=0.02];
  r_dicta -- ESC [label="N", color="#424242:white:#424242", len=1.6];
  r_dicta -- DIS [label="M", len=1.6];
