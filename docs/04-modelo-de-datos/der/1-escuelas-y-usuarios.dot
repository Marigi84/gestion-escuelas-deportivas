  USU_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  USU -- USU_a0 [len=0.9];
  USU_a1 [shape=ellipse, style="solid", peripheries=1, label="Mail", fontsize=10, margin=0.02, height=0.3];
  USU -- USU_a1 [len=0.9];
  USU_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
