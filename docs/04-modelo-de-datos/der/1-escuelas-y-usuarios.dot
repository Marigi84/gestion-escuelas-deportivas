graph G {
  graph [overlap=false, splines=true, sep="+12", fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#424242"];
  ESC [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Escuela", fontsize=12];
  ESC_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  ESC -- ESC_a0 [len=0.9];
  ESC_a1 [shape=ellipse, style="solid", peripheries=1, label="Nombre", fontsize=10, margin=0.02, height=0.3];
  ESC -- ESC_a1 [len=0.9];
  ESC_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  ESC -- ESC_a2 [len=0.9];
  ESC_a3 [shape=ellipse, style="solid", peripheries=1, label="Fecha de alta", fontsize=10, margin=0.02, height=0.3];
  ESC -- ESC_a3 [len=0.9];
  ESC_a4 [shape=ellipse, style="solid", peripheries=1, label="Fecha de baja", fontsize=10, margin=0.02, height=0.3];
