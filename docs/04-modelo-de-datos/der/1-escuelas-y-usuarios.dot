  CFG_a2 [shape=ellipse, style="solid", peripheries=1, label="Contacto", fontsize=10, margin=0.02, height=0.3];
  CFG -- CFG_a2 [len=0.9];
  CFG_a3 [shape=ellipse, style="solid", peripheries=1, label="Día de vencimiento sugerido", fontsize=10, margin=0.02, height=0.3];
  CFG -- CFG_a3 [len=0.9];
  CFG_a4 [shape=ellipse, style="solid", peripheries=2, label="Recargos sugeridos", fontsize=10, margin=0.02, height=0.3];
