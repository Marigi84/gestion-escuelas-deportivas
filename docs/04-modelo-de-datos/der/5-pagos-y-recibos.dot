graph G {
  graph [overlap=false, splines=true, sep="+12", fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#424242"];
  OPE [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Operación", fontsize=12];
  OPE_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a0 [len=0.9];
  OPE_a1 [shape=ellipse, style="solid", peripheries=1, label="Importe", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a1 [len=0.9];
  OPE_a2 [shape=ellipse, style="solid", peripheries=1, label="Fecha de pago", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a2 [len=0.9];
  OPE_a3 [shape=ellipse, style="solid", peripheries=1, label="Fecha de registro", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a3 [len=0.9];
  OPE_a4 [shape=ellipse, style="solid", peripheries=1, label="Descripción", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a4 [len=0.9];
  OPE_a5 [shape=ellipse, style="solid", peripheries=1, label="Cargada sin conexión", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a5 [len=0.9];
  OPE_a6 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  OPE -- OPE_a6 [len=0.9];
  PAG [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Pago", fontsize=12];
  PAG_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Número de parte</u></i>>, fontsize=10, margin=0.02, height=0.3];
  PAG -- PAG_a0 [len=0.9];
  PAG_a1 [shape=ellipse, style="solid", peripheries=1, label="Concepto", fontsize=10, margin=0.02, height=0.3];
  PAG -- PAG_a1 [len=0.9];
  PAG_a2 [shape=ellipse, style="solid", peripheries=1, label="Importe", fontsize=10, margin=0.02, height=0.3];
  PAG -- PAG_a2 [len=0.9];
  PAG_a3 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  PAG -- PAG_a3 [len=0.9];
  PAG_a4 [shape=ellipse, style="dashed", peripheries=1, label="Saldo a favor", fontsize=10, margin=0.02, height=0.3];
  PAG -- PAG_a4 [len=0.9];
  IMP [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Imputación", fontsize=12];
  IMP_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha y hora</u></i>>, fontsize=10, margin=0.02, height=0.3];
  IMP -- IMP_a0 [len=0.9];
  IMP_a1 [shape=ellipse, style="solid", peripheries=1, label="Importe", fontsize=10, margin=0.02, height=0.3];
  IMP -- IMP_a1 [len=0.9];
  IMP_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  IMP -- IMP_a2 [len=0.9];
  RCB [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Recibo", fontsize=12];
  RCB_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Número</u></i>>, fontsize=10, margin=0.02, height=0.3];
  RCB -- RCB_a0 [len=0.9];
  RCB_a1 [shape=ellipse, style="solid", peripheries=1, label="Fecha de emisión", fontsize=10, margin=0.02, height=0.3];
  RCB -- RCB_a1 [len=0.9];
  RCB_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  RCB -- RCB_a2 [len=0.9];
  ESC [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Escuela", fontsize=12, fontcolor="#616161"];
  FDP [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Forma de pago", fontsize=12, fontcolor="#616161"];
  ALU [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Alumno", fontsize=12, fontcolor="#616161"];
  CUO [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Cuota", fontsize=12, fontcolor="#616161"];
  REC [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Recargo", fontsize=12, fontcolor="#616161"];
  INS [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Inscripción a evento", fontsize=12, fontcolor="#616161"];
  PED [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Pedido de indumentaria", fontsize=12, fontcolor="#616161"];
  r_registra [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="registra", fontsize=10, margin=0.02];
  r_registra -- ESC [label="1", len=1.6];
  r_registra -- OPE [label="N", color="#424242:white:#424242", len=1.6];
  r_con [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="se paga con", fontsize=10, margin=0.02];
  r_con -- OPE [label="N", color="#424242:white:#424242", len=1.6];
  r_con -- FDP [label="1", len=1.6];
  r_reparte [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="se reparte en", fontsize=10, margin=0.02];
  r_reparte -- OPE [label="1", color="#424242:white:#424242", len=1.6];
  r_reparte -- PAG [label="N", color="#424242:white:#424242", len=1.6];
  r_para [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="a favor de", fontsize=10, margin=0.02];
  r_para -- PAG [label="N", color="#424242:white:#424242", len=1.6];
  r_para -- ALU [label="1", len=1.6];
  r_aplica [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="se aplica en", fontsize=10, margin=0.02];
  r_aplica -- PAG [label="1", len=1.6];
  r_aplica -- IMP [label="N", color="#424242:white:#424242", len=1.6];
  r_c_cuo [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="cancela", fontsize=10, margin=0.02];
  r_c_cuo -- IMP [label="N", len=1.6];
  r_c_cuo -- CUO [label="1", len=1.6];
  r_c_rec [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="cancela", fontsize=10, margin=0.02];
  r_c_rec -- IMP [label="N", len=1.6];
  r_c_rec -- REC [label="1", len=1.6];
  r_c_ins [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="cancela", fontsize=10, margin=0.02];
  r_c_ins -- IMP [label="N", len=1.6];
  r_c_ins -- INS [label="1", len=1.6];
  r_c_ped [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="cancela", fontsize=10, margin=0.02];
  r_c_ped -- IMP [label="N", len=1.6];
  r_c_ped -- PED [label="1", len=1.6];
  r_emite [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="emite", fontsize=10, margin=0.02];
  r_emite -- PAG [label="1", len=1.6];
  r_emite -- RCB [label="N", color="#424242:white:#424242", len=1.6];
  r_numera [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="numera", fontsize=10, margin=0.02];
  r_numera -- ESC [label="1", len=1.6];
  r_numera -- RCB [label="N", color="#424242:white:#424242", len=1.6];
}
