graph G {
  graph [overlap=false, splines=true, sep="+12", fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#424242"];
  PRE [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Preinscripción", fontsize=12];
  PRE_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  PRE -- PRE_a0 [len=0.9];
  PRE_a1 [shape=ellipse, style="solid", peripheries=1, label="Fecha de recepción", fontsize=10, margin=0.02, height=0.3];
  PRE -- PRE_a1 [len=0.9];
  PRE_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  PRE -- PRE_a2 [len=0.9];
  PRE_a3 [shape=ellipse, style="solid", peripheries=1, label="Datos del formulario", fontsize=10, margin=0.02, height=0.3];
  PRE -- PRE_a3 [len=0.9];
  ALU [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Alumno", fontsize=12];
  ALU_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>DNI</u></i>>, fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a0 [len=0.9];
  ALU_a1 [shape=ellipse, style="solid", peripheries=1, label="Nombre", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a1 [len=0.9];
  ALU_a2 [shape=ellipse, style="solid", peripheries=1, label="Apellido", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a2 [len=0.9];
  ALU_a3 [shape=ellipse, style="solid", peripheries=1, label="Fecha de nacimiento", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a3 [len=0.9];
  ALU_a4 [shape=ellipse, style="solid", peripheries=1, label="Domicilio", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a4 [len=0.9];
  ALU_a5 [shape=ellipse, style="solid", peripheries=1, label="Escuela a la que asiste", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a5 [len=0.9];
  ALU_a6 [shape=ellipse, style="solid", peripheries=1, label="Observaciones", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a6 [len=0.9];
  ALU_a7 [shape=ellipse, style="dashed", peripheries=1, label="Categoría", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a7 [len=0.9];
  ALU_a8 [shape=ellipse, style="dashed", peripheries=1, label="Activo", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a8 [len=0.9];
  ALU_a9 [shape=ellipse, style="dashed", peripheries=1, label="Deudor", fontsize=10, margin=0.02, height=0.3];
  ALU -- ALU_a9 [len=0.9];
  SAL [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Datos de salud", fontsize=12];
  SAL_a0 [shape=ellipse, style="solid", peripheries=1, label="Alergias", fontsize=10, margin=0.02, height=0.3];
  SAL -- SAL_a0 [len=0.9];
  SAL_a1 [shape=ellipse, style="solid", peripheries=1, label="Condiciones médicas", fontsize=10, margin=0.02, height=0.3];
  SAL -- SAL_a1 [len=0.9];
  SAL_a2 [shape=ellipse, style="solid", peripheries=1, label="Apto médico", fontsize=10, margin=0.02, height=0.3];
  SAL -- SAL_a2 [len=0.9];
  PER [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Permanencia", fontsize=12];
  PER_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha de alta</u></i>>, fontsize=10, margin=0.02, height=0.3];
  PER -- PER_a0 [len=0.9];
  PER_a1 [shape=ellipse, style="solid", peripheries=1, label="Fecha de baja", fontsize=10, margin=0.02, height=0.3];
  PER -- PER_a1 [len=0.9];
  PER_a2 [shape=ellipse, style="solid", peripheries=1, label="Motivo de baja", fontsize=10, margin=0.02, height=0.3];
  PER -- PER_a2 [len=0.9];
  GRU [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Grupo familiar", fontsize=12];
  GRU_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  GRU -- GRU_a0 [len=0.9];
  ESC [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Escuela", fontsize=12, fontcolor="#616161"];
  TUT [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Tutor", fontsize=12, fontcolor="#616161"];
  r_recibe [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="recibe", fontsize=10, margin=0.02];
  r_recibe -- ESC [label="1", len=1.6];
  r_recibe -- PRE [label="N", color="#424242:white:#424242", len=1.6];
  r_crea [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="al aprobarse crea", fontsize=10, margin=0.02];
  r_crea -- PRE [label="1", len=1.6];
  r_crea -- ALU [label="1", len=1.6];
  r_inscribe [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="inscribe", fontsize=10, margin=0.02];
  r_inscribe -- ESC [label="1", len=1.6];
  r_inscribe -- ALU [label="N", color="#424242:white:#424242", len=1.6];
  r_salud [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="tiene", fontsize=10, margin=0.02];
  r_salud -- ALU [label="1", len=1.6];
  r_salud -- SAL [label="1", color="#424242:white:#424242", len=1.6];
  r_perm [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="registra", fontsize=10, margin=0.02];
  r_perm -- ALU [label="1", color="#424242:white:#424242", len=1.6];
  r_perm -- PER [label="N", color="#424242:white:#424242", len=1.6];
  r_grupo [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="pertenece a", fontsize=10, margin=0.02];
  r_grupo -- ALU [label="N", len=1.6];
  r_grupo -- GRU [label="1", color="#424242:white:#424242", len=1.6];
  r_cargo [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="está a cargo de", fontsize=10, margin=0.02];
  r_cargo -- TUT [label="N", color="#424242:white:#424242", len=1.6];
  r_cargo -- ALU [label="M", color="#424242:white:#424242", len=1.6];
  r_cargo_a0 [shape=ellipse, label="Parentesco", fontsize=10, margin=0.02, height=0.3];
  r_cargo -- r_cargo_a0 [len=0.9];
}
