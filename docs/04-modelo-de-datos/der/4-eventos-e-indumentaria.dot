graph G {
  graph [overlap=false, splines=true, sep="+12", fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.5];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, color="#424242"];
  EVE [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Evento", fontsize=12];
  EVE_a0 [shape=ellipse, style="solid", peripheries=1, label=<<u>Identificador</u>>, fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a0 [len=0.9];
  EVE_a1 [shape=ellipse, style="solid", peripheries=1, label="Nombre", fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a1 [len=0.9];
  EVE_a2 [shape=ellipse, style="solid", peripheries=1, label="Fecha", fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a2 [len=0.9];
  EVE_a3 [shape=ellipse, style="solid", peripheries=1, label="Descripción", fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a3 [len=0.9];
  EVE_a4 [shape=ellipse, style="solid", peripheries=1, label="Precio", fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a4 [len=0.9];
  EVE_a5 [shape=ellipse, style="dashed", peripheries=1, label="Participantes", fontsize=10, margin=0.02, height=0.3];
  EVE -- EVE_a5 [len=0.9];
  INS [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Inscripción a evento", fontsize=12];
  INS_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha de inscripción</u></i>>, fontsize=10, margin=0.02, height=0.3];
  INS -- INS_a0 [len=0.9];
  INS_a1 [shape=ellipse, style="solid", peripheries=1, label="Precio", fontsize=10, margin=0.02, height=0.3];
  INS -- INS_a1 [len=0.9];
  INS_a2 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  INS -- INS_a2 [len=0.9];
  INS_a3 [shape=ellipse, style="dashed", peripheries=1, label="Saldo", fontsize=10, margin=0.02, height=0.3];
  INS -- INS_a3 [len=0.9];
  PED [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Pedido de indumentaria", fontsize=12];
  PED_a0 [shape=ellipse, style="solid", peripheries=1, label=<<i><u>Fecha y hora</u></i>>, fontsize=10, margin=0.02, height=0.3];
  PED -- PED_a0 [len=0.9];
  PED_a1 [shape=ellipse, style="solid", peripheries=1, label="Importe", fontsize=10, margin=0.02, height=0.3];
  PED -- PED_a1 [len=0.9];
  PED_a2 [shape=ellipse, style="solid", peripheries=1, label="Descripción", fontsize=10, margin=0.02, height=0.3];
  PED -- PED_a2 [len=0.9];
  PED_a3 [shape=ellipse, style="solid", peripheries=1, label="Estado", fontsize=10, margin=0.02, height=0.3];
  PED -- PED_a3 [len=0.9];
  PED_a4 [shape=ellipse, style="dashed", peripheries=1, label="Saldo", fontsize=10, margin=0.02, height=0.3];
  PED -- PED_a4 [len=0.9];
  ESC [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=1, label="Escuela", fontsize=12, fontcolor="#616161"];
  ALU [shape=box, style="filled", fillcolor="#eeeeee", color="#9e9e9e", peripheries=2, label="Alumno", fontsize=12, fontcolor="#616161"];
  r_organiza [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=1, label="organiza", fontsize=10, margin=0.02];
  r_organiza -- ESC [label="1", len=1.6];
  r_organiza -- EVE [label="N", color="#424242:white:#424242", len=1.6];
  r_de [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="de", fontsize=10, margin=0.02];
  r_de -- EVE [label="1", len=1.6];
  r_de -- INS [label="N", color="#424242:white:#424242", len=1.6];
  r_anota [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="se anota", fontsize=10, margin=0.02];
  r_anota -- ALU [label="1", len=1.6];
  r_anota -- INS [label="N", color="#424242:white:#424242", len=1.6];
  r_pide [shape=diamond, style=filled, fillcolor="#fff3cd", color="#b8860b", peripheries=2, label="pide", fontsize=10, margin=0.02];
  r_pide -- ALU [label="1", len=1.6];
  r_pide -- PED [label="N", color="#424242:white:#424242", len=1.6];
}
