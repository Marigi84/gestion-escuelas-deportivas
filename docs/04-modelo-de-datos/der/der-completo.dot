  CFG [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=2, label="Configuración", fontsize=12];
  DIS [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Disciplina", fontsize=12];
  FDP [shape=box, style="filled", fillcolor="#fde2e2", color="#c62828", peripheries=1, label="Forma de pago", fontsize=12];
